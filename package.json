{
  "name": "orange-hrm-qa-demo",
  "version": "1.0.0",
  "description": "Playwright with JavaScript automation framework built using the Page Object Model (POM). Covers OrangeHRM test scenarios with a clean, scalable, and maintainable structure.",
  "main": "index.js",
  "dependencies": {
    "dotenv": "^18.0.1",
    "playwright": "^1.63.0",
    "playwright-bdd": "^9.2.1",
    "playwright-core": "^1.63.0",
    "undici-types": "^8.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2"
  },
  "scripts": {
    "bddgen": "bddgen",
    "test": "bddgen && playwright test",
    "test:smoke": "bddgen --tags \"@smoke\" && playwright test",
    "test:qa": "ENV=qa npm run test -- --headed",
    "report": "playwright show-report",
    "report:cucumber": "open cucumber-report/index.html",
    "test:user-crud": "bddgen --tags \"@user-crud\" && playwright test --project=user-crud-parallel-create --project=user-crud-delete-dependent",
    "test:login": "bddgen && playwright test features/authentication/login.feature.spec.js --project=setup --project=chromium --workers=3 --headed",
    "test:login:sit": "bddgen && playwright test features/authentication/login.feature.spec.js --project=setup --project=chromium --workers=3 --headed --grep @sit",
    "test:login:login": "bddgen && playwright test features/authentication/login.feature.spec.js --project=setup --project=chromium --workers=3 --headed --grep @login"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akshayqa11/orange-hrm-qa-demo.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/akshayqa11/orange-hrm-qa-demo/issues"
  },
  "homepage": "https://github.com/akshayqa11/orange-hrm-qa-demo#readme"
}
